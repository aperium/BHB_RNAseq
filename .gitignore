# BHB RNA-seq Pipeline - Git Ignore File

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# R and RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.egg-info/

# Data files (too large for git)
*.fq.gz
*.fastq.gz
*.bam
*.bai
*.sam
*.fa
*.fasta
*.gtf
*.gff

# Output directories (generated by pipeline)
logs/
00.Reference/
01.RawData/
03.FastQC_raw/
04.Alignment/
05.Counts/
06.DESeq2_results/

# SLURM job outputs
slurm-*.out

# Temporary files
*.tmp
*.temp
*.log

# Documentation build artifacts
SETUP_INSTRUCTIONS_files/

# Sensitive information
*.key
*.pem
credentials.txt
